# Your public address. Caddy gets a free HTTPS certificate for GRIT_DOMAIN automatically.
GRIT_DOMAIN=habits.example.com
GRIT_PUBLIC_URL=https://habits.example.com

# Email for password reset links. Leave GRIT_SMTP_HOST empty to disable reset emails.
GRIT_SMTP_HOST=
GRIT_SMTP_PORT=587
GRIT_SMTP_USER=
GRIT_SMTP_PASSWORD=
GRIT_SMTP_FROM=Habit Tracker <no-reply@habits.example.com>
